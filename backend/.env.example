NODE_ENV=development
PORT=5000
API_PREFIX=/api

# MongoDB Atlas URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/mailvault?retryWrites=true&w=majority

# JWT & Session
JWT_SECRET=your-jwt-secret-here-change-in-production-min-32-chars
JWT_REFRESH_SECRET=your-refresh-secret-here-change-in-production-min-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=your-cookie-secret-here

FRONTEND_URL=http://localhost:3000

# Email (SMTP / Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
EMAIL_FROM=noreply@mailvault.com

# Resend API
RESEND_API_KEY=re_your_resend_api_key

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Server-side Encryption Key (64 hex characters / 32 bytes)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Default System Admin
ADMIN_EMAIL=admin@mailvault.com
ADMIN_PASSWORD=AdminPassword123!
