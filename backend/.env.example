# MailVault Backend Environment Variables
# Copy this to .env and fill in values

# Server
NODE_ENV=development
PORT=5000
API_PREFIX=/api

# MongoDB
MONGODB_URI=mongodb://localhost:27017/mailvault
# MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/mailvault

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cookie
COOKIE_SECRET=your-cookie-secret-change-in-production

# CORS
FRONTEND_URL=http://localhost:3000

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=noreply@mailvault.com

# Encryption
ENCRYPTION_KEY=your-32-byte-hex-encryption-key-here

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Admin
ADMIN_EMAIL=admin@mailvault.com
ADMIN_PASSWORD=AdminPassword123!
