# MailVault Backend Environment Variables (Dev)
NODE_ENV=development
PORT=5000
API_PREFIX=/api
MONGODB_URI=mongodb://localhost:27017/mailvault
JWT_SECRET=dev-jwt-secret-mailvault-2024-change-in-production
JWT_REFRESH_SECRET=dev-jwt-refresh-secret-mailvault-2024-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=dev-cookie-secret-mailvault-2024
FRONTEND_URL=http://localhost:3000
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@mailvault.com
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
ADMIN_EMAIL=admin@mailvault.com
ADMIN_PASSWORD=AdminPassword123!
